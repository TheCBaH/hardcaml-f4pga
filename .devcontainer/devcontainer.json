// For format details, see https://aka.ms/devcontainer.json.
{
    "name": "hardcaml-f4pga",
    "runArgs": ["--init", "--privileged"], // USB access for programming
    "mounts": [
        "source=/dev/,target=/dev/,type=bind,consistency=cached"
    ],
    "build":  {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": "true",
            "username": "vscode",
            "userUid": "1000",
            "userGid": "1000",
            "upgradePackages": "false"
        },
        "ghcr.io/devcontainers/features/sshd:1": {},
        "ghcr.io/thecbah/ocaml-features/ocaml:1": {
            "version": "${localEnv:OCAML_VERSION:4.14.3}",
            "packages": "utop ocamlformat#0.29.0 hardcaml hardcaml_c hardcaml_circuits hardcaml_verilator hardcaml_waveterm hardcaml_xilinx",
            "ocaml-version-overrides": "notty.0.2.3#git+https://github.com/Octachron/notty.git#a4d62f467e257196a5192da2184bd021dfd948b7@5.4.*"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "mshr-h.veriloghdl",
                "ocamllabs.ocaml-platform"
            ]
        }
    },
    "remoteUser": "vscode",
    "containerEnv": {
        "OPAMROOT": "/opt/opam"
    },
    "postCreateCommand": {
        "opam": "sudo .devcontainer/fix-opam-owner.sh $(id -u) $(id -g)"
    },
    "waitFor": "postCreateCommand"
}
